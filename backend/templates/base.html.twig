<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Oldenburg&display=swap" rel="stylesheet">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>"> {% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body>
		<nav class="navbar">
			<div class="navbar-inner">
				<div class="brand">
					<img class="logo" src="{{ asset('img/LogoLCDLT.png') }}" alt="Logo Les Contes de la Taverne">
					<span class="brand-name">Les Contes de la Taverne</span>
				</div>
				<div class="nav-links">
					<a class="btn" href="{{ path('app_home') }}">Accueil</a>
					<a class="btn" href="{{ path('app_story_index') }}">Histoires</a>
					<a class="btn" href="{{ path('app_welcome') }}">À propos</a>
					{% if app.user %}
						<a class="btn" href="{{ path('app_story_new') }}">Écrire</a>
						<a class="btn" href="{{ path('app_logout') }}">Déconnexion</a>
					{% else %}
						<a class="btn" href="{{ path('app_login') }}">Connexion</a>
						<a class="btn" href="{{ path('app_register') }}">Créer un compte</a>
					{% endif %}
				</div>
				<div class="burger-menu" onclick="toggleMobileMenu()">
					<div class="burger-line"></div>
					<div class="burger-line"></div>
					<div class="burger-line"></div>
				</div>
			</div>
			<div class="mobile-menu">
				<div class="nav-links">
					<a class="btn" href="{{ path('app_home') }}">Accueil</a>
					<a class="btn" href="{{ path('app_story_index') }}">Histoires</a>
					<a class="btn" href="{{ path('app_welcome') }}">À propos</a>
					{% if app.user %}
						<a class="btn" href="{{ path('app_story_new') }}">Écrire</a>
						<a class="btn" href="{{ path('app_logout') }}">Déconnexion</a>
					{% else %}
						<a class="btn" href="{{ path('app_login') }}">Connexion</a>
						<a class="btn" href="{{ path('app_register') }}">Créer un compte</a>
					{% endif %}
				</div>
			</div>
		</nav>
		<div class="container"> {% block body %}{% endblock %}
			</div>
			<footer class="footer">
				<div class="footer-inner">
					<small>©
						{{ "now"|date("Y") }}
						Les Contes de la Taverne</small>
					<div class="footer-links">
						<a href="{{ path('app_welcome') }}">À propos</a>
						<a href="#">Contact</a>
						<a href="#">Mentions légales</a>
					</div>
				</div>
			</footer>
		</body>
	</html>
